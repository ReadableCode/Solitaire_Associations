# Solitaire Associations config — the real .env here is a symlink to
# ../personal_credentials/personal.env. Never commit real values.

# --- self-contained stack (compose.yaml): only these three are needed ---
# letters and digits only (they go into a connection URL and SQL);
# generate each with `openssl rand -hex 32`
# POSTGRES_PASSWORD=
# POSTGREST_DB_PASSWORD=
# POSTGREST_JWT_SECRET=            # 32+ characters
# SOLITAIRE_PORT=8790

# --- running the app against an existing Postgres + PostgREST ---
# (compose.external.yaml, or uv run uvicorn as in the README)
#
# Everything below is optional for the app to start: with no Postgres and no
# PostgREST it still serves the login page, the level list and a degraded
# /api/health, but nobody can log in, so levels cannot be played or saved.
# Set the block you need.

# --- schema / storage ---
# Own schema in the shared `apps` Postgres; PostgREST reads it via
# Accept-Profile, RLS keyed on the JWT user_id claim.
APP_SCHEMA=solitaire
POSTGREST_URL=

# --- direct-DB paths only: startup bootstrap, login verify, account CLI ---
POSTGRES_URL=
POSTGRES_PORT=5432
POSTGRES_DB=apps
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- session cookie signing (generate with: openssl rand -base64 32) ---
# Must equal the shared PostgREST JWT secret: the same token the cookie holds
# is forwarded verbatim as the PostgREST Bearer token. JWT_SECRET is accepted
# as a fallback name.
POSTGREST_JWT_SECRET=

# --- optional: override the level bank (defaults to data/levels.json) ---
SOLITAIRE_LEVELS_PATH=
