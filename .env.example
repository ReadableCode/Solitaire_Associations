# Solitaire Associations config — the real .env here is a symlink to
# ../personal_credentials/personal.env. Never commit real values.
#
# Everything below is optional for a bare local run: with no Postgres and no
# PostgREST the app still serves and plays, it just cannot log anyone in or
# save progress. Set the block you need.

# --- schema / storage ---
# Own schema in the shared `apps` Postgres; PostgREST reads it via
# Accept-Profile, RLS keyed on the JWT user_id claim.
APP_SCHEMA=solitaire
POSTGREST_URL=

# --- direct-DB paths only: startup bootstrap, login verify, account CLI ---
POSTGRES_URL=
POSTGRES_PORT=5432
POSTGRES_DB=apps
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- session cookie signing (generate with: openssl rand -base64 32) ---
# Must equal the shared PostgREST JWT secret: the same token the cookie holds
# is forwarded verbatim as the PostgREST Bearer token. JWT_SECRET is accepted
# as a fallback name.
POSTGREST_JWT_SECRET=

# --- optional: override the level bank (defaults to data/levels.json) ---
SOLITAIRE_LEVELS_PATH=
